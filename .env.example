# ParkPlug frontend configuration
#
# Copy to `.env.local` and fill in the values you have. Everything left unset
# renders as an explicit placeholder in the UI rather than an invented value.

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# When set, the frontend talks to this API instead of browser-local storage.
# NEXT_PUBLIC_API_BASE_URL=https://api.parkplug.example

# Canonical origin, used for SEO metadata, sitemap, and Open Graph URLs.
# NEXT_PUBLIC_SITE_URL=https://parkplug.example

# ---------------------------------------------------------------------------
# Maps and geocoding
# ---------------------------------------------------------------------------
# Raster tile template. Defaults to OpenStreetMap, which needs no key but is
# not licensed for production traffic — point this at your own tile provider
# before launch.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Address lookup endpoint. Defaults to OpenStreetMap Nominatim.
# NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Until this is set, checkout explains that payment processing is not yet
# connected instead of reporting a successful charge.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# ---------------------------------------------------------------------------
# Fees, in basis points (1000 = 10%)
# ---------------------------------------------------------------------------
# Unset means "not yet confirmed": the pricing page shows a placeholder and
# checkout will not quote a final total.
# NEXT_PUBLIC_SERVICE_FEE_BPS=
# NEXT_PUBLIC_HOST_FEE_BPS=
# NEXT_PUBLIC_TAX_BPS=

# ---------------------------------------------------------------------------
# Business and legal details
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_LEGAL_NAME=
# NEXT_PUBLIC_MAILING_ADDRESS=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_PRIVACY_EMAIL=
# NEXT_PUBLIC_GOVERNING_STATE=
# NEXT_PUBLIC_POLICY_EFFECTIVE_DATE=
# NEXT_PUBLIC_SUPPORT_RESPONSE_TIME=

# Set to "true" only if listings really do publish without review.
# NEXT_PUBLIC_LISTINGS_AUTO_PUBLISH=false

# Social links — the footer hides the social row entirely while these are unset.
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
# NEXT_PUBLIC_SOCIAL_X=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
