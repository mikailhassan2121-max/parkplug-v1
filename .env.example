# ParkPlug frontend configuration
#
# Copy to `.env.local` and fill in the values you have. Everything left unset
# renders as an explicit placeholder in the UI rather than an invented value.

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# When set, the frontend talks to this API instead of browser-local storage.
# NEXT_PUBLIC_API_BASE_URL=https://api.parkplug.example

# Canonical origin, used for SEO metadata, sitemap, and Open Graph URLs.
# NEXT_PUBLIC_SITE_URL=https://parkplug.example

# ---------------------------------------------------------------------------
# Maps and geocoding
# ---------------------------------------------------------------------------
# Raster tile template. Defaults to OpenStreetMap, which needs no key but is
# not licensed for production traffic — point this at your own tile provider
# before launch.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Dark basemap tile template, used everywhere the map renders (search, /live,
# facility pages). Defaults to CARTO dark_matter, which needs no key but is
# not licensed for production traffic — point this at your own tile provider
# (e.g. Stadia Alidade Smooth Dark) before launch.
# NEXT_PUBLIC_DARK_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_matter/{z}/{x}/{y}{r}.png

# Address lookup endpoint. Defaults to OpenStreetMap Nominatim.
# NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# ---------------------------------------------------------------------------
# Live sensor platform
# ---------------------------------------------------------------------------
# Base URL of the Railway API — reused for the sensor snapshot/SSE endpoints
# consumed directly by the browser (Netlify serverless can't hold an SSE
# connection open, so this must point at Railway, not a Next.js route).
# NEXT_PUBLIC_API_BASE_URL=https://api.parkplug.example

# Gates the /admin/sensor-simulator page. Off by default — set to "true"
# only in demo/staging environments. The simulator itself still requires an
# authenticated host session even when this is on.
# NEXT_PUBLIC_ADMIN_SIMULATOR_ENABLED=false

# Server-side only (no NEXT_PUBLIC_ prefix) — never sent to the browser. Must
# be the exact same value as server/.env's SENSOR_INGEST_TOKEN. Used only by
# src/app/api/admin/simulate/route.ts, which attaches it to the simulator's
# requests so the browser never sees it.
SENSOR_INGEST_TOKEN=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Until this is set, checkout explains that payment processing is not yet
# connected instead of reporting a successful charge. Use a test-mode
# publishable key (pk_test_...) until you're ready to take real charges —
# must be the same Stripe account as the backend's STRIPE_SECRET_KEY.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# ---------------------------------------------------------------------------
# Fees, in basis points (1000 = 10%)
# ---------------------------------------------------------------------------
# ParkPlugs keeps 15% of the driver's subtotal, deducted from the host's
# payout via Stripe Connect — not an extra charge on top. Both already
# default to this split (src/config/business.ts) even when left unset here;
# only set these if the split changes. Must match server/.env's
# SERVICE_FEE_BPS / HOST_FEE_BPS.
# NEXT_PUBLIC_SERVICE_FEE_BPS=0
# NEXT_PUBLIC_HOST_FEE_BPS=1500
# NEXT_PUBLIC_TAX_BPS=

# ---------------------------------------------------------------------------
# Business and legal details
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_LEGAL_NAME=
# NEXT_PUBLIC_MAILING_ADDRESS=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_PRIVACY_EMAIL=
# NEXT_PUBLIC_GOVERNING_STATE=
# NEXT_PUBLIC_POLICY_EFFECTIVE_DATE=
# NEXT_PUBLIC_SUPPORT_RESPONSE_TIME=

# Listings publish immediately by default (no review step exists). Set to
# "false" to hold new listings at "in_review" instead — must match the
# backend's LISTINGS_AUTO_PUBLISH (server/.env) or the copy shown to hosts
# during listing creation will be wrong.
# NEXT_PUBLIC_LISTINGS_AUTO_PUBLISH=true

# Social links — the footer hides the social row entirely while these are unset.
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
# NEXT_PUBLIC_SOCIAL_X=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
