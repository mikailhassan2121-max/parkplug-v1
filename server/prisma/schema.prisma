// ParkPlug data model.
//
// Mirrors the TypeScript domain model in ../../src/lib/types.ts field for
// field, so the API layer can map a Prisma row onto a frontend type with no
// renaming. Money is always integer cents; timestamps are UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------- Enums ----------------------------------

enum VehicleSize {
  compact
  standard
  large
  oversized
}

enum ParkingType {
  driveway
  garage
  private_lot
  apartment_space
  business_lot
  organization_lot
  other
}

enum Amenity {
  covered
  ev_charging
  accessible
  lit
  gated
  camera_monitored
  attended
  paved
  level_entry
}

enum SurfaceType {
  asphalt
  concrete
  gravel
  grass
  paver
}

enum ListingStatus {
  draft
  in_review
  needs_changes
  active
  paused
  archived
}

enum ReservationStatus {
  pending
  confirmed
  in_progress
  completed
  canceled
  refunded
}

enum ReportRestriction {
  time_limited
  metered
  free_certain_hours
  permit_required
  street_cleaning
  loading_zone
  accessible_only
  other
  unknown
}

enum ReportConfidence {
  low
  medium
  high
}

enum ReportStatus {
  active
  expired
  taken
  withdrawn
}

enum ReviewRole {
  driver
  host
}

enum NotificationType {
  reservation_confirmed
  reservation_reminder
  host_new_booking
  reservation_canceled
  refund_update
  listing_approved
  listing_needs_changes
  review_reminder
  new_message
  report_update
  support_reply
}

enum PayoutState {
  not_started
  incomplete
  pending_verification
  action_required
  complete
}

enum VoteKind {
  confirm
  taken
}

// --------------------------------- Models ----------------------------------

model User {
  id             String   @id @default(cuid())
  fullName       String
  email          String   @unique
  passwordHash   String
  emailVerified  Boolean  @default(false)
  avatarUrl      String?
  isHost         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Notification preferences, flattened rather than JSON so each is a real,
  // queryable, typed column.
  notifyReservationUpdates Boolean @default(true)
  notifyReminders          Boolean @default(true)
  notifyMessages            Boolean @default(true)
  notifyProductNews         Boolean @default(false)
  notifyChannelEmail        Boolean @default(true)
  notifyChannelPush         Boolean @default(false)

  vehicles           Vehicle[]
  listings           Listing[]           @relation("HostListings")
  reservations       Reservation[]       @relation("DriverReservations")
  reports            FreeParkingReport[]
  reviewsAuthored    Review[]            @relation("ReviewAuthor")
  savedListings      SavedListing[]
  notifications      Notification[]
  sessions           Session[]
  emailVerifications EmailVerificationToken[]
  passwordResets     PasswordResetToken[]
  supportTickets     SupportTicket[]
  reportVotes        ReportVote[]
  payoutAccount      PayoutAccount?
  conversationsAsDriver Conversation[]   @relation("ConversationDriver")
  conversationsAsHost   Conversation[]   @relation("ConversationHost")
  messagesSent          Message[]

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  userAgent String?

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

model Vehicle {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  make          String
  model         String
  color         String
  licensePlate  String
  plateRegion   String
  size          VehicleSize
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  reservations Reservation[]

  @@index([userId])
}

model Listing {
  id          String        @id @default(cuid())
  slug        String        @unique
  hostId      String
  host        User          @relation("HostListings", fields: [hostId], references: [id], onDelete: Cascade)

  title       String
  description String
  parkingType ParkingType
  status      ListingStatus @default(in_review)

  pricePerHourCents Int
  dailyMaxCents     Int?
  currency          String  @default("USD")

  spacesTotal        Int         @default(1)
  maxVehicleSize     VehicleSize
  heightClearanceCm  Int?
  amenities          Amenity[]
  surface            SurfaceType?
  entranceNotes      String?
  accessibilityNotes String?

  minimumMinutes        Int
  maximumMinutes        Int
  advanceNoticeMinutes  Int @default(0)
  bufferMinutes         Int @default(0)

  rules String[]

  cancellationSummary            String  @default("Free cancellation up to 1 hour before your arrival time.")
  cancellationFullRefundHoursBefore Int  @default(1)

  instantBook Boolean @default(true)
  viewCount   Int     @default(0)

  // Public, approximate location (offset point + label).
  locationLabel  String
  neighborhood   String?
  city           String
  state          String
  centerLat      Float
  centerLng      Float
  radiusMeters   Int     @default(200)

  // Private — released to a driver only on a confirmed reservation.
  addressLine1     String
  addressLine2     String?
  addressCity      String
  addressState     String
  addressPostalCode String
  addressCountry   String @default("US")
  privateInstructions String @default("")

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos       ListingPhoto[]
  availability ListingAvailability[]
  reservations Reservation[]
  reviews      Review[]
  savedBy      SavedListing[]
  conversations Conversation[]

  @@index([hostId])
  @@index([status])
  @@index([centerLat, centerLng])
}

model ListingPhoto {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  width     Int
  height    Int
  position  Int     @default(0)

  @@index([listingId])
}

model ListingAvailability {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String

  @@index([listingId])
}

model Reservation {
  id        String             @id @default(cuid())
  reference String             @unique
  status    ReservationStatus  @default(confirmed)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  userId    String
  user      User    @relation("DriverReservations", fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  startAt DateTime
  endAt   DateTime

  currency           String
  subtotalCents      Int
  discountCents      Int?
  serviceFeeCents    Int
  taxCents           Int
  totalCents         Int
  hostEarningsCents  Int?
  hostFeeCents       Int?

  // Snapshots taken at booking time so a later listing edit never rewrites
  // history a driver already paid for.
  exactAddressLine1     String
  exactAddressLine2     String?
  exactAddressCity      String
  exactAddressState     String
  exactAddressPostalCode String
  exactAddressCountry   String
  hostInstructions      String
  cancellationSummary   String
  cancellationFullRefundHoursBefore Int

  stripePaymentIntentId String?

  createdAt   DateTime  @default(now())
  canceledAt  DateTime?

  timeline ReservationTimelineEvent[]
  review   Review?
  conversation Conversation?

  @@index([listingId])
  @@index([userId])
  @@index([status])
}

model ReservationTimelineEvent {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  at            DateTime    @default(now())
  label         String
  description   String?

  @@index([reservationId])
}

model FreeParkingReport {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  locationLabel String
  neighborhood  String?
  city          String
  state         String
  centerLat     Float
  centerLng     Float
  radiusMeters  Int     @default(200)

  observedAt DateTime
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  spacesObserved  Int
  sideOfStreet    String?
  landmark        String?
  restrictions    ReportRestriction[]
  restrictionNotes String?
  timeLimitMinutes Int?
  confidence      ReportConfidence
  confirmations   Int     @default(0)
  markedTakenCount Int    @default(0)
  status          ReportStatus @default(active)
  photoUrl        String?
  notes           String?

  votes ReportVote[]

  @@index([userId])
  @@index([status])
  @@index([centerLat, centerLng])
  @@index([expiresAt])
}

model ReportVote {
  id       String            @id @default(cuid())
  reportId String
  report   FreeParkingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind     VoteKind
  createdAt DateTime         @default(now())

  @@unique([reportId, userId, kind])
}

model Review {
  id            String   @id @default(cuid())
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reservationId String   @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  role          ReviewRole

  rating Int

  categoryAccuracy  Int?
  categoryAccess    Int?
  categorySafety    Int?
  categoryValue     Int?

  categoryCommunication  Int?
  categoryTimeliness     Int?
  categoryRuleCompliance Int?

  body            String
  privateFeedback String?

  responseBody String?
  responseAt   DateTime?

  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([authorId])
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  href      String?
  createdAt DateTime          @default(now())
  readAt    DateTime?

  @@index([userId])
}

model SupportTicket {
  id                  String   @id @default(cuid())
  reference           String   @unique
  category            String
  reservationReference String?
  name                String
  email               String
  description         String
  preferredResponse   String
  attachmentUrl        String?
  createdAt           DateTime @default(now())
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PayoutAccount {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  state         PayoutState @default(not_started)
  missingFields String[]
  actionReason  String?
  methodSummary String?
  stripeAccountId String?
  updatedAt     DateTime    @updatedAt
}

// A conversation is always scoped to one reservation, so a host and driver
// can only reach each other about a booking they actually share.
model Conversation {
  id            String   @id @default(cuid())
  reservationId String   @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  driverId      String
  driver        User     @relation("ConversationDriver", fields: [driverId], references: [id], onDelete: Cascade)
  hostId        String
  host          User     @relation("ConversationHost", fields: [hostId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  messages Message[]

  @@index([driverId])
  @@index([hostId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  sentAt         DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId])
}
