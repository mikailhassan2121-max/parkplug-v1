# ParkPlug backend configuration

# On Supabase (or anywhere tables shouldn't live in the default "public"
# schema), append ?schema=app — Prisma creates and migrates that schema
# automatically. See server/README.md, "Using Supabase".
DATABASE_URL="postgresql://parkplug@localhost:5432/parkplug"
PORT=4000
NODE_ENV=development

# Origin(s) allowed to send credentialed requests. Comma-separated.
CORS_ORIGIN=http://localhost:3000

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Payments -----------------------------------------------------------
# Until this is set, reservation creation returns a payment_unavailable
# error rather than a fabricated success — same behaviour as the frontend's
# local-storage adapter. Use a test-mode secret key (sk_test_...) until
# you're ready to take real charges.
STRIPE_SECRET_KEY=
# Signing secret for the /webhooks/stripe endpoint, from the Stripe
# dashboard's webhook config for that exact endpoint URL (a CLI-forwarded
# webhook during local dev has its own, different secret — see
# `stripe listen --print-secret`). Left unset, webhooks are rejected rather
# than trusted unverified — payment_intent.succeeded, payment_intent.failed,
# and charge.refunded all need this destination ("Events from: Your account").
STRIPE_WEBHOOK_SECRET=
# Second signing secret for a SEPARATE webhook destination whose "Events
# from" is set to "Connected accounts" — required for account.updated on a
# host's Express account, which Stripe only ever delivers to a
# connected-accounts destination, never the account one above. Same endpoint
# URL (/webhooks/stripe), different destination in the Stripe dashboard,
# different secret. Optional; without it, Connect events fail signature
# verification and a host's payout status never flips to "complete".
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Marketplace commission ----------------------------------------------
# Basis points (1000 = 10%). ParkPlugs keeps 15% of the driver's subtotal,
# deducted from the host's payout via Stripe Connect's application_fee_amount
# — not an extra charge on top of what the driver pays. Both already default
# to this split (server/src/env.ts) even when left unset here; only set
# these if the split changes.
# SERVICE_FEE_BPS=0
# HOST_FEE_BPS=1500

# --- Email ------------------------------------------------------------------
# Sent via a provider's HTTP API, not SMTP — some hosts (Railway's trial tier
# among them) block outbound SMTP ports 465/587 entirely, while plain HTTPS is
# never blocked. Until a provider is configured, transactional email is
# logged to the server console instead of silently pretending to have sent.
#
# Set the API key for whichever provider you're using — MAIL_PROVIDER picks
# between them if both happen to be set, otherwise it's inferred. Resend
# refuses to deliver to anyone but the account owner until a sending domain
# is verified; Brevo only needs single-sender verification, so it's the
# faster path to sending real signups before a domain is ready.
# MAIL_PROVIDER=brevo
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM="ParkPlug <no-reply@parkplug.example>"
# Optional: gets a copy of every support ticket. Leave unset to skip it.
SUPPORT_NOTIFY_EMAIL=

# --- Geocoding ----------------------------------------------------------------
# /geocode/search proxies OpenStreetMap Nominatim — no API key needed, but
# FRONTEND_URL (below) is sent as part of the required User-Agent per
# Nominatim's usage policy.

# --- Uploads ----------------------------------------------------------------
# Local disk storage for listing photos. Point this at a mounted volume in
# production, or swap uploads.ts for an S3-compatible client.
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads

# --- Listings -----------------------------------------------------------
# New listings publish immediately by default (no review step exists). Set
# to "false" to hold new listings at "in_review" instead.
# LISTINGS_AUTO_PUBLISH=true

# --- Live sensor platform ------------------------------------------------
# Bearer token real ESP32 hardware (and the server-side simulator proxy)
# authenticates with against POST /api/v1/sensors/*. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Left unset, the ingest endpoints reject every request rather than
# accepting unauthenticated writes.
SENSOR_INGEST_TOKEN=
# Seconds a sensor can go quiet before the background sweeper flips its
# space to OFFLINE.
# SENSOR_OFFLINE_AFTER_SECONDS=90
# Server-side gate for /admin/sensor-simulator, on top of the route's own
# admin-auth check and the frontend's NEXT_PUBLIC_ADMIN_SIMULATOR_ENABLED.
# Leave off outside demo/staging environments.
# ADMIN_SIMULATOR_ENABLED=false
# Set to "true" and run `npm run seed` to populate the demo facility
# (TEST-GARAGE-001) used by the sensor simulator. Safe to run repeatedly —
# the seed is idempotent. See prisma/seed.ts.
# DEMO_SEED=false
