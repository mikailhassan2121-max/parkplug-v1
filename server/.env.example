# ParkPlug backend configuration

DATABASE_URL="postgresql://parkplug@localhost:5432/parkplug"
PORT=4000
NODE_ENV=development

# Origin(s) allowed to send credentialed requests. Comma-separated.
CORS_ORIGIN=http://localhost:3000

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Payments -----------------------------------------------------------
# Until this is set, reservation creation returns a payment_unavailable
# error rather than a fabricated success — same behaviour as the frontend's
# local-storage adapter.
STRIPE_SECRET_KEY=

# --- Email ----------------------------------------------------------------
# Until these are set, transactional email is logged to the server console
# instead of silently pretending to have been sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ParkPlug <no-reply@parkplug.example>"

# --- Uploads ----------------------------------------------------------------
# Local disk storage for listing photos. Point this at a mounted volume in
# production, or swap uploads.ts for an S3-compatible client.
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads
